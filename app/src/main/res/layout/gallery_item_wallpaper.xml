<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="1dp">

    <ImageView
        android:id="@+id/wallpaperThumbnail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_placeholder"
        android:scaleType="centerCrop"
        android:contentDescription="@string/wallpaper_thumbnail"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/selectionOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/wallpaperThumbnail"
        app:layout_constraintEnd_toEndOf="@id/wallpaperThumbnail"
        app:layout_constraintStart_toStartOf="@id/wallpaperThumbnail"
        app:layout_constraintTop_toTopOf="@id/wallpaperThumbnail" />

    <ImageView
        android:id="@+id/checkIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="8dp"
        android:src="@drawable/ic_check"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/wallpaperThumbnail"
        app:layout_constraintTop_toTopOf="@id/wallpaperThumbnail"
        app:tint="@android:color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>