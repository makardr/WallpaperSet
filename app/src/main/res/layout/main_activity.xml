<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <ImageView
        android:id="@+id/wallpaperPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/wallpaper_preview_description"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/tooltip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="35dp"
        android:layout_marginEnd="35dp"
        android:text="@string/tooltip_content"
        android:textColor="@color/text_color"
        android:textSize="20sp" />

    <FrameLayout
        android:id="@+id/topPanelContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="32dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/panelToggle"
            android:layout_width="40dp"
            android:layout_height="64dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_semicircle_empty"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/ripple_semicircle"
            android:src="@drawable/ic_arrow_left"
            android:scaleType="centerInside"
            android:paddingEnd="8dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:id="@+id/topControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/openExplorer"
                style="@style/IconButtonContainer"
                android:contentDescription="@string/open_image_explorer_description">

                <ImageView
                    style="@style/ImgButtonIcon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/open_file_explorer_button" />

                <TextView
                    style="@style/ButtonLabel"
                    android:text="@string/label_open" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cropImage"
                style="@style/IconButtonContainer"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/crop_selected_image_description">

                <ImageView
                    style="@style/ImgButtonIcon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/crop_image_button" />

                <TextView
                    style="@style/ButtonLabel"
                    android:text="@string/label_crop" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/openGallery"
                style="@style/IconButtonContainer"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/gallery_button_description">

                <ImageView
                    style="@style/ImgButtonIcon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/gallery_image_button" />

                <TextView
                    style="@style/ButtonLabel"
                    android:text="@string/label_gallery" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/preferencesButton"
                style="@style/IconButtonContainer"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/settings_button_description">

                <ImageView
                    style="@style/ImgButtonIcon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/open_settings_button" />

                <TextView
                    style="@style/ButtonLabel"
                    android:text="@string/label_settings" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/setWallpaperButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="10dp"
        android:text="@string/set_wallpaper_button"
        android:textColor="@color/button_text"
        app:backgroundTint="@color/button_background"
        app:cornerRadius="12dp" />
</FrameLayout>